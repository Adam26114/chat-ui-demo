# Server-only settings. Supply approved credentials manually; never commit real secrets.
# The local issuer accepts only an anonymous x_auth_token; do not invent a JWT or profile.
# Keep CHAT_SERVER_KEY server-only and never trim it. ws:// is not TLS protected.
CHAT_SERVER_KEY=
CHAT_APP_KEY=
CHAT_CUSTOMER_ID=
CHAT_PROPERTY_CODE=
CHAT_BOOKING_LINK=
CHAT_LOGIN_LINK=
CHAT_PAYMENT_LINK=
CHAT_BASE_URL=http://127.0.0.1:5173/
CHAT_ISSUER_PORT=8787
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:5173
CHAT_SERVER_URL=ws://ubicompsystem.no-ip.org:5000
